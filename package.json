{
  "name": "chrome-plugin-manga-translator",
  "version": "2.1.1",
  "description": "Chrome插件，用于翻译漫画中的文字，并保持原有样式",
  "type": "module",
  "scripts": {
    "dev": "node scripts/inject-env-config.mjs && node scripts/copy-tesseract.js && vite",
    "build": "node scripts/inject-env-config.mjs && node scripts/check-release-consistency.mjs --source-only && node scripts/check-store-claims.mjs --source-only && node scripts/copy-tesseract.js && tsc && vite build && node scripts/check-release-consistency.mjs && node scripts/record-source-fingerprint.mjs",
    "build:public": "node scripts/inject-env-config.mjs --public-build && node scripts/check-release-consistency.mjs --source-only && node scripts/check-store-claims.mjs --source-only && node scripts/check-public-build.mjs --source-only && node scripts/copy-tesseract.js && tsc && vite build && node scripts/check-public-build.mjs && node scripts/check-release-consistency.mjs && node scripts/record-source-fingerprint.mjs",
    "package:public": "pnpm build:public && node scripts/package-extension.mjs",
    "smoke:public": "node scripts/smoke-test-public-build.mjs",
    "release:check": "node scripts/check-release-consistency.mjs && node scripts/check-store-claims.mjs",
    "publish:store": "node scripts/publish-to-store.mjs",
    "release:publish": "pnpm package:public && node scripts/publish-to-store.mjs",
    "store:capture": "node scripts/capture-store-assets.mjs",
    "store:popup": "node scripts/capture-store-assets.mjs --popup",
    "store:options": "node scripts/capture-store-assets.mjs --options",
    "store:promo": "node scripts/build-promo-image.mjs",
    "check:claims": "node scripts/check-store-claims.mjs",
    "preview": "vite preview",
    "test": "node scripts/inject-env-config.mjs && vitest",
    "test:ui": "node scripts/inject-env-config.mjs && vitest --ui",
    "test:run": "node scripts/inject-env-config.mjs && vitest run",
    "test:coverage": "node scripts/inject-env-config.mjs && vitest run --coverage && node scripts/check-coverage-scope.mjs",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "node scripts/inject-env-config.mjs && tsc --noEmit",
    "prepare": "husky install"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "translation",
    "ai",
    "openai",
    "react",
    "typescript"
  ],
  "author": "Manga Translator contributors",
  "license": "MIT",
  "homepage": "https://github.com/hibernate-pano/chrome-plugin-manga-translator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibernate-pano/chrome-plugin-manga-translator.git"
  },
  "bugs": {
    "url": "https://github.com/hibernate-pano/chrome-plugin-manga-translator/issues"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.294.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "9.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.251",
    "@types/node": "25.9.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.27.7",
    "eslint": "9.39.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.4.0",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^6.4.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
