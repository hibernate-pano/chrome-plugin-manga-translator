# Manga Translator — provider credentials (injected at build time)
#
# Copy to `.env` at the project root, or keep a master copy at
# `~/.env` (the inject script searches up to 3 levels above the project).
#
# All three providers below are required for the extension to be useful.
# Anything left blank falls back to no-op defaults and the corresponding
# provider card will show "未配置" / "未检测到 key" in the Options page.

# ---- Primary: MiniMax M3 (OpenAI-compatible) -------------------------------
MINIMAX_API_PATH=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_API_MODEL=MiniMax-M3

# ---- Backup: OpenCodeGo-routed DeepSeek V4 Flash --------------------------
OPEN_CODE_API_PATH=https://opencode.ai/zen/go/v1
OPEN_CODE_API_KEY=
OPEN_CODE_API_MODEL=deepseek-v4-flash

# ---- Local Ollama ----------------------------------------------------------
# Host of the local Ollama daemon (no /v1 suffix; Ollama uses its native API).
# Model must already be pulled locally, e.g. `ollama pull llava`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava